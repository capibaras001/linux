					key_vol_up {

						key_vol_up_default {
							pins = "gpio6";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x01>;
							phandle = <0x697>;
						};
					};

					display_panel_avdd_default {
						phandle = <0x75d>;
						qcom,drive-strength = <0x03>;
						power-source = <0x01>;
						bias-disable;
						output-enable;
						input-disable;
						function = "normal";
						pins = "gpio11";
					};

					fan_pwm {

						fan_pwm {
							phandle = <0x86c>;
							drive-push-pull;
							power-source = <0x00>;
							qcom,drive-strength = <0x03>;
							output-high;
							output-enable;
							input-disable;
							function = "func1";
							pins = "gpio9";
						};
					};
				};

				led-controller {
					compatible = "qcom,pm8350c-pwm";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#pwm-cells = <0x02>;
					nvmem = <0x65e 0x65f>;
