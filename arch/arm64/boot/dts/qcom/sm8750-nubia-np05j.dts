					reset-gpios = <0x26 0x3c 0x00>;
					irq-gpio = <0x26 0x39 0x00>;
					reg = <0x44>;
					compatible = "zte,bos1921", "awinic,aw86320";
				};
			};

			qupv3_hub_i2c9: i2c@9a4000 {
