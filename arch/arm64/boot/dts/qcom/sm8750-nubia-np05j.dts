			qupv3_hub_i2c8: i2c@9a0000 {
				compatible = "qcom,i2c-geni";
				reg = <0x9a0000 0x4000>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				interrupts = <0x00 0x1d8 0x04>;
				clock-names = "se-clk", "core-clk";
				clocks = <0x34 0x4f 0x34 0x3e>;
				interconnect-names = "qup-core", "qup-config";
				interconnects = <0x276 0x26 0x276 0x236 0x7f 0x02 0x80 0x20b>;
				pinctrl-names = "default", "sleep";
				pinctrl-0 = <0x354 0x355>;
				pinctrl-1 = <0x356>;
