				fmtag@57 {
					phandle = <0x876>;
					status = "ok";
					vdd-supply = <0x435>;
					reset-gpios = <0x26 0x51 0x00>;
					irq-gpios = <0x26 0x6c 0x00>;
					interrupts = <0x6c 0x00>;
					interrupt-parent = <0x26>;
					reg = <0x57>;
					compatible = "fm,fmtag";
				};

				bos1921@44 {
					status = "okay";
					atsin0_phase = <0x00>;
					atsin0_polor = <0x00>;
					is_reg_method_play;
					pinctrl-1 = <0x86a>;
					pinctrl-0 = <0x869>;
