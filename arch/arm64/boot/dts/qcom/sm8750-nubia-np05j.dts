			ranges = <0x00 0x14680bf8 0x200>;
			reg = <0x14680bf8 0x200>;

			efs_golden_copy@04 {
				reg = <0x04 0x08>;
				compatible = "qcom,msm-imem-efs-golden-copy";
			};

			pm-count-time@0c {
				reg = <0x0c 0x18>;
				compatible = "qcom,msm-vendor-imem-pm-count-time";
			};

			sd_dump_mode@2c {
				reg = <0x2c 0x04>;
				compatible = "qcom,msm-vendor-imem-sd_dump_mode";
			};

			board_id@60 {
				reg = <0x60 0x04>;
				compatible = "qcom,msm-imem-board-id";
			};

			vlog_memory_cookie@64 {
				reg = <0x64 0x04>;
				compatible = "qcom,msm-vendor-imem-vlog_memory_cookie";
			};

			vlog_memory_addr@68 {
				reg = <0x68 0x04>;
				compatible = "qcom,msm-vendor-imem-vlog_memory_addr";
			};

			vlog_memory_size@6c {
				reg = <0x6c 0x04>;
				compatible = "qcom,msm-imem-vlog_memory_size";
			};

			ddr_memory_manufacture@d8 {
				reg = <0xd8 0x04>;
				compatible = "qcom,msm-imem-ddr_memory_manufacture";
			};

			ddr_memory_type@dc {
				reg = <0xdc 0x04>;
				compatible = "qcom,msm-imem-ddr_memory_type";
			};

			ddr_memory_size@e0 {
				reg = <0xe0 0x04>;
				compatible = "qcom,msm-imem-ddr_memory_size";
			};

			s2_reset_type@e4 {
				reg = <0xec 0x04>;
				compatible = "qcom,msm-imem-s2_reset_type";
			};

			rf_version_id@ec {
				reg = <0xf4 0x04>;
				compatible = "qcom,msm-imem-rf_version_id";
			};
		};

		charger_policy_service {
			policy,cas-phy-name = "cas";
			policy,interface-phy-name = "interface";
			policy,battery-phy-name = "battery";
			policy,no-powerpath-delta-capacity = <0x0a>;
			policy,demo-min-capacity = <0x46>;
			policy,demo-max-capacity = <0x5a>;
			policy,expired-min-capacity = <0x46>;
			policy,expired-max-capacity = <0x5a>;
			policy,timeout-seconds = <0x2a300>;
			policy,have-power-path = <0x01>;
			policy,low-temp-enable = <0x00>;
			policy,expired-mode-enable = <0x01>;
			policy,retry-times = <0x0a>;
			policy,enable = <0x01>;
			status = "okay";
			compatible = "zte,charger-policy-service";
		};

		zte_misc_service {
			status = "okay";
			compatible = "zte-misc";
		};

		goodix_fp {
			interrupt-names = "goodix_wake_up";
			goodix,gpio_pwr = <0x26 0xd6 0x01>;
			fp-gpio-irq = <0x26 0x63 0x2008>;
			fp-gpio-reset = <0x26 0x4e 0x00>;
			pinctrl-2 = <0x85e>;
			pinctrl-1 = <0x85d>;
			pinctrl-0 = <0x85c>;
			pinctrl-names = "goodix_active", "goodix_suspend", "pwr_active";
			interrupts = <0x63 0x2008>;
			interrupt-parent = <0x26>;
			reg = <0x00>;
			qcom,qup-id = <0x03>;
			spi-max-frequency = "", "I>";
			compatible = "goodix,fingerprint";
			status = "ok";
		};

		hall_sensor {
			linux,name = "hall_sensor";
			ah,gpio_irq = <0x26 0x41 0x00>;
			linux,max-uv = <0x1b7740>;
			linux,min-uv = <0x1b7740>;
			vddio-supply = <0x402>;
			compatible = "ah,hall_ic";
		};

		hall2_sensor {
			linux,name = "hall2_sensor";
			ah2,gpio_irq = <0x26 0x42 0x00>;
			linux,max-uv = <0x1b7740>;
			linux,min-uv = <0x1b7740>;
			vddio-supply = <0x402>;
			compatible = "ah2,hall_ic2";
		};

		gpio_keys_nubia {
			pinctrl-0 = <0x860>;
			pinctrl-names = "default";
			label = "gpio-keys_nubia";
			compatible = "gpio-keys_nubia";
			status = "ok";

			game_sw {
				gpio-key,wakeup;
				debounce-interval = <0x1e>;
				linux,code = <0x0f>;
				linux,input-type = <0x05>;
				gpion = <0x26 0xc7 0x00>;
				gpios = <0x26 0xc6 0x00>;
				label = "game_sw";
			};
		};

		nubia_usb_switch_dp_gpio_ctrl {
			phandle = <0x86f>;
			status = "okay";
			compatible = "nubia,usb_switch_dp";
		};

		zte_tp {
			phandle = <0x870>;
			zte,ufp_enable;
			zte,tp_edge_click_suppression_pixel = <0x00>;
			zte,tp_long_press_right_h = <0x00>;
			zte,tp_long_press_left_h = <0x00>;
			zte,tp_long_press_right_v = <0x00>;
			zte,tp_long_press_left_v = <0x00>;
			zte,tp_long_press_timer = <0x320>;
			zte,tp_long_press;
			zte,tp_jitter_timer = <0x50>;
			zte,tp_jitter_check = <0x01>;
			zte,tp_algo;
			compatible = "zte_tp";
		};

		nubia_hw_gpio_ctrl {
			phandle = <0x871>;
			pinctrl-1 = <0x862>;
			pinctrl-0 = <0x861>;
			pinctrl-names = "pull_up_default", "pull_down_default";
			qcom,rf-gpio2 = <0x26 0x8b 0x00>;
			qcom,rf-gpio1 = <0x26 0x8a 0x00>;
			qcom,pcb-gpio3 = <0x26 0x6b 0x00>;
			qcom,pcb-gpio2 = <0x26 0x6a 0x00>;
			qcom,pcb-gpio1 = <0x26 0x69 0x00>;
			compatible = "nubia_hw_gpio_ctrl";
		};
	};

	hypervisor: hypervisor {
		phandle = <0x573>;
		#address-cells = <0x02>;
		#size-cells = <0x00>;
		compatible = "qcom,gunyah-hypervisor-1.0", "qcom,gunyah-hypervisor", "simple-bus";

		gh_watchdog: qcom,gh-watchdog {
			phandle = <0x574>;
			compatible = "qcom,gh-watchdog";
			interrupts = <0x00 0x00 0x04>;
		};

		qcom,gunyah-vm {
			compatible = "qcom,gunyah-vm-id-1.0", "qcom,gunyah-vm-id";
			qcom,vmid = <0x03>;
			qcom,vendor = "Qualcomm";
		};

		qcom,resource-manager-rpc@e1c45d34cf740bcd {
			compatible = "gunyah-resource-manager", "qcom,resource-manager-1-0", "qcom,resource-manager";
			reg = <0xe1c45d34 0xcf740bcd 0xe1c45d34 0xcf74b7b3>;
			interrupts = <0x00 0x3c0 0x01 0x00 0x3c1 0x01>;
			qcom,free-irq-start = <0x3c0>;
			qcom,is-full-duplex;
			qcom,tx-message-size = <0xf0>;
			qcom,rx-message-size = <0xf0>;
			qcom,tx-queue-depth = <0x08>;
			qcom,rx-queue-depth = <0x08>;
		};
	};

